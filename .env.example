#choose between native compiled and jvm runtime version commenting/uncommenting those env variables
DOCKER_FILE_NAME=Dockerfile.native
#for jvm build version
#DOCKER_FILE_NAME=Dockerfile.jvm

#disable open telemetry locally
OTEL_TRACES_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_SAMPLER=always_off

## Azure Service Bus
# Connection strings
LOCAL_CONNECTION_STRING=Endpoint=sb://localhost;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=SAS_KEY_VALUE;UseDevelopmentEmulator=true;
SERVICE_BUS_ECOMMERCE_SYNC_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_ECOMMERCE_SYNC_RETRY_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_GEC_SYNC_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_GEC_SYNC_RETRY_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_SESSION_POLL_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_SESSION_EXPIRE_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"
SERVICE_BUS_SYSTEM_TELEMETRY_CONNECTION_STRING="${LOCAL_CONNECTION_STRING}"

# Queues
SERVICE_BUS_ECOMMERCE_SYNC_QUEUE_NAME=posgw.cmd.ecommerce.sync
SERVICE_BUS_ECOMMERCE_SYNC_RETRY_QUEUE_NAME=posgw.cmd.ecommerce.sync.retry
SERVICE_BUS_GEC_SYNC_QUEUE_NAME=posgw.cmd.gec.sync
SERVICE_BUS_GEC_SYNC_RETRY_QUEUE_NAME=posgw.cmd.gec.sync.retry
SERVICE_BUS_SESSION_POLL_QUEUE_NAME=posgw.cmd.session.poll
SERVICE_BUS_SESSION_EXPIRE_QUEUE_NAME=posgw.cmd.session.expire

# Topic
SERVICE_BUS_SYSTEM_TELEMETRY_TOPIC_NAME=posgw.evt.sys.telemetry

## Mongo
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=admin
MONGO_PASSWORD=password
MONGO_SSL_ENABLED=false
MONGO_MIN_POOL_SIZE=0
MONGO_MAX_POOL_SIZE=20
MONGO_MAX_IDLE_TIMEOUT_MS=60000
MONGO_CONNECTION_TIMEOUT_MS=1000
MONGO_SOCKET_TIMEOUT_MS=10000
MONGO_SERVER_SELECTION_TIMEOUT_MS=2000
MONGO_WAITING_QUEUE_MS=2000
MONGO_HEARTBEAT_FREQUENCY_MS=5000
# the posgw-local replica set advertises its docker hostname, so connect to the host port directly
MONGO_REPLICA_SET_OPTION="&directConnection=true"
